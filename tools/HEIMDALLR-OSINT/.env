# ================================================================
# HeimdallrOsint — Environment Configuration
# Copy this file to `.env` and fill in values.
# ================================================================

# --- App ---
APP_NAME=HeimdallrOsint
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- Database ---
# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///./heimdallr.db

# --- Target ---
# Single domain to monitor for MVP
TARGET_DOMAIN=smktelkom-pwt.sch.id

# --- Scheduler ---
# Scan interval in minutes (set high during dev to avoid rate limits)
SCAN_INTERVAL_MINUTES=60
# Run initial scan on app startup
SCAN_ON_STARTUP=false

# --- Collectors ---
# GitHub Personal Access Token (classic). Leave empty to disable GitHub collector.
# Scopes required: public_repo (read-only public code search is enough)
GITHUB_TOKEN=

# XposedOrNot — no auth required for public endpoints
XPOSEDORNOT_BASE_URL=https://api.xposedornot.com/v1

# LeakCheck public API key (optional — free tier with registration)
# Leave empty to skip this collector
LEAKCHECK_API_KEY=

# crt.sh — no auth
CRTSH_BASE_URL=https://crt.sh

# Pastebin via DuckDuckGo HTML (no API key, scrapes search results)
PASTEBIN_ENABLED=true

# --- HTTP ---
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
USER_AGENT=HeimdallrOsint/0.1 (+https://github.com/yourname/heimdallr)

# --- Google Dork (via DuckDuckGo HTML, no API key) ---
GOOGLE_DORK_ENABLED=true
GOOGLE_DORK_TIERS=1,2,3
GOOGLE_DORK_DELAY_SECONDS=1.8
GOOGLE_DORK_MAX_RESULTS=8
