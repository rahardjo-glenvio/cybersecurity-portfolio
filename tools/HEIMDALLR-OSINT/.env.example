# ================================================================
# HeimdallrOsint — Environment Configuration
# Copy this file to `.env` and fill in values.
# ================================================================

# --- App ---
APP_NAME=HeimdallrOsint
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./heimdallr.db

# --- Default target (seeded on first boot; add more targets via the UI) ---
TARGET_DOMAIN=example.com

# --- Scheduler ---
SCAN_INTERVAL_MINUTES=60
SCAN_ON_STARTUP=false

# --- Collectors ---
# GitHub PAT with public_repo scope (30 req/min).
GITHUB_TOKEN=

# XposedOrNot — no auth required.
XPOSEDORNOT_BASE_URL=https://api.xposedornot.com/v1

# LeakCheck — optional API key.
LEAKCHECK_API_KEY=

# crt.sh — no auth.
CRTSH_BASE_URL=https://crt.sh

# Pastebin / paste-site search via DuckDuckGo HTML.
PASTEBIN_ENABLED=true

# --- Google Dork (via DuckDuckGo HTML, no API key) ---
# Master toggle.
GOOGLE_DORK_ENABLED=true

# Active tiers (comma-sep). Effect on scan time with default throttle (~1.8s/query):
#   Tier 1       ~30 dorks    ~1 min
#   Tier 1,2     ~70 dorks    ~2.5 min
#   Tier 1,2,3   ~120 dorks   ~4 min   ← most exhaustive; DDG may throttle
GOOGLE_DORK_TIERS=1,2,3

# Throttle between DDG queries (seconds). Lower = faster but higher block risk.
GOOGLE_DORK_DELAY_SECONDS=1.8

# Max DDG result rows parsed per dork query.
GOOGLE_DORK_MAX_RESULTS=8

# --- HTTP ---
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
USER_AGENT=HeimdallrOsint/0.1
