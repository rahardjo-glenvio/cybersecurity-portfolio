# ============================================================
# Sentinel SOC Dashboard — Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_very_long_random_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=          # Generate with: node scripts/generateHash.js

# Wazuh Manager API
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=your_wazuh_password

# Wazuh Indexer (OpenSearch)
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
INDEXER_PASSWORD=your_indexer_password

# Server/Target Location (for map destination marker)
SERVER_LAT=-7.4333
SERVER_LON=109.2333
SERVER_CITY=Your City
SERVER_COUNTRY=Your Country
