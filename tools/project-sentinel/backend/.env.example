# ============================================================
# Sentinel SOC Dashboard — Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# CORS — comma-separated list of origins allowed to call this API.
# Must include the exact scheme://host:port you load the dashboard on.
# Leave EMPTY to allow loopback + private LAN ranges (10.x, 192.168.x,
# 172.16-31.x) on any port, which suits a homelab. Set it explicitly if the
# backend is reachable from anywhere untrusted.
CORS_ORIGINS=

# JWT Authentication
JWT_SECRET=your_very_long_random_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=          # Generate with: npm run hash

# Wazuh Manager REST API — NOT currently used.
# SENTINEL reads alerts.json directly (see ALERTS_JSON_PATH below) and never
# calls the manager API. These are kept as placeholders for a future agent/
# rule-management feature; nothing breaks if you leave them blank.
WAZUH_API_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=

# Wazuh alerts.json — read directly for real-time data (no indexer/filebeat needed).
# Any path works: point it at a copied/sample log to test without a Wazuh install.
ALERTS_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# Server/Target Location (for map destination marker)
SERVER_LAT=-7.4333
SERVER_LON=109.2333
SERVER_CITY=Your City
SERVER_COUNTRY=Your Country
